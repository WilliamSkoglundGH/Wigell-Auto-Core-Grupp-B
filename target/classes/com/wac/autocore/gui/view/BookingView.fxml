<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<VBox styleClass="container-padding,container-spacing" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wac.autocore.gui.controller.BookingController">

    <children>

        <!-- Titel -->
        <Label styleClass="heading-2" text="%booking.heading" />

        <!-- Tabell -->
        <TableView fx:id="bookingTable">

        <columns>
                <TableColumn fx:id="idColumn" text="%table.id" />
                <TableColumn fx:id="vehicleIdColumn" text="%booking.vehicleIdColumn" />
                <TableColumn fx:id="dateColumn" text="%booking.dateColumn" />
                <TableColumn fx:id="descriptionColumn" maxWidth="275.0" text="%table.description"/>
                <TableColumn fx:id="statusColumn" text="%table.status" />
                <TableColumn fx:id="mechanicColumn" text="%booking.mechanicColumn" />
            <TableColumn fx:id="estimateColumn" sortable="false" text="%booking.estimateColumn" />
            </columns>
        </TableView>

        <HBox styleClass="button-spacing">
            <Button text="%btn.new"
                    onAction="#handleNewBooking"/>

            <Button text="%booking.services.show"
                    onAction="#handleShowBookingServices"/>
            <Button text="%booking.btn.copy" onAction="#handleCopyBooking"/>
        </HBox>

    </children>
</VBox>
