<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.HBox?>
<VBox styleClass="container-padding,container-spacing"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.wac.autocore.gui.controller.ServiceItemController">

       <Label text="%serviceItem.packages.heading" styleClass="heading-2" />

        <TableView fx:id="servicePackageTable">
            <columns>
                <TableColumn fx:id="packageIdColumn" text="%table.id" />
                <TableColumn fx:id="packageNameColumn" text="%table.name" />
                <TableColumn fx:id="packageDescriptionColumn" text="%serviceItem.package.label.description" />
                <TableColumn fx:id="packageServicesColumn" text="%serviceItem.package.label.select_items" />
                <TableColumn fx:id="packageActiveColumn" text="%serviceItem.package.active" />
            </columns>
        </TableView>
        <HBox styleClass="button-spacing">
        <Button text="%btn.new" onAction="#handleNewPackage" />
        <Button text="%btn.back" onAction="#handleCancel" />
        </HBox>

</VBox>