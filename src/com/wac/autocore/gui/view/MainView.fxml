<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainRoot" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.wac.autocore.gui.controller.MainController"
            prefHeight="800.0" prefWidth="1000.0">
    <!-- MENY TILL VÄNSTER -->
    <left>
        <VBox styleClass="button-spacing,text-center,container-padding-small">
            <Label text="WAC" styleClass="heading-1"/>
            <Label text="Wigell Auto Core" styleClass="caption"/>
            <Button text="Customers" onAction="#showCustomerView" prefWidth="120" />
            <Button text="Vehicles" onAction="#showVehicleView" prefWidth="120" />
            <Button text="Bookings" onAction="#showBookingView" prefWidth="120" />
            <Button text="Workorders" onAction="#showWorkOrderView" prefWidth="120" />
            <Button text="Invoices" onAction="#showInvoiceView" prefWidth="120" />
            <Button text="Payments" onAction="#showPaymentView" prefWidth="120" />
            <Button text="Serviceitems" onAction="#showServiceItemView" prefWidth="120" />
            <Button text="Exit" onAction="#handleExit" prefWidth="120" />
        </VBox>
    </left>

    <!-- CENTER (Här laddas respektive FXML dynamiskt) -->
    <center >
        <!-- Standardvyn när programmet startar -->
        <VBox styleClass="content-center">
            <Label text="Welcome" styleClass="heading-2" />
        </VBox>
    </center>

    <!-- MEDDELANDEN TILL ANVÄNDAREN -->
    <bottom>
        <BorderPane styleClass="container-padding-small">
            <center>
                <Label fx:id="messageLabel"
                       text=""
                       wrapText="true"
                       maxWidth="Infinity"
                       minHeight="30"/>
            </center>

            <right>
                <Button text="Exit"
                        onAction="#handleExit"
                        prefWidth="120"
                        BorderPane.alignment="BOTTOM_RIGHT"/>
            </right>
        </BorderPane>
    </bottom>
</BorderPane>