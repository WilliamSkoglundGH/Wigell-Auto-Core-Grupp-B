<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="container-padding,container-spacing"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.wac.autocore.gui.controller.BookingController">

    <children>

        <!-- Titel -->
        <Label text="Booking Management" styleClass="heading-2" />

        <!-- Tabell -->
        <TableView fx:id="bookingTable">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" />
                <TableColumn fx:id="vehicleIdColumn" text="Vehicle ID" />
                <TableColumn fx:id="dateColumn" text="Date" />
                <TableColumn fx:id="descriptionColumn" text="Description" />
                <TableColumn fx:id="statusColumn" text="Status" />
            </columns>
        </TableView>

        <!-- Knapp för att skapa ny booking -->
        <Button text="New Booking" onAction="#handleNewBooking" />

    </children>
</VBox>



