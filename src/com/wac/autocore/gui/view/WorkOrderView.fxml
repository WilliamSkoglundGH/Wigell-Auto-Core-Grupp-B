<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="container-padding,container-spacing"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.wac.autocore.gui.controller.WorkOrderController">

    <children>
        <Label text="Work Order Management" styleClass="heading-2" />

        <TableView fx:id="workOrderTable">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" />
                <TableColumn fx:id="bookingIdColumn" text="Booking ID" />
                <TableColumn fx:id="mechanicIdColumn" text="Mechanic ID" />
                <TableColumn fx:id="statusColumn" text="Status" />
                <TableColumn fx:id="servicesColumn" text="Service Items" />
            </columns>
        </TableView>

        <HBox styleClass="button-spacing">
            <Button text="New" onAction="#handleNewWorkOrder" />
            <Button text="Start" onAction="#handleStartWorkOrder" />
            <Button text="Complete" onAction="#handleCompleteWorkOrder" />
        </HBox>
    </children>
</VBox>