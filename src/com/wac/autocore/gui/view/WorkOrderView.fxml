<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.wac.autocore.gui.controller.WorkOrderController">

    <children>
        <Label text="Work Order Management" styleClass="heading-2" />

        <TableView fx:id="workOrderTable">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" />
                <TableColumn fx:id="bookingIdColumn" text="Booking ID" />
                <TableColumn fx:id="mechanicIdColumn" text="Mechanic ID" />
                <TableColumn fx:id="serviceItemIdsColumn" text="Service Item IDs" />
                <TableColumn fx:id="statusColumn" text="Status" />
            </columns>
        </TableView>
    </children>
</VBox>