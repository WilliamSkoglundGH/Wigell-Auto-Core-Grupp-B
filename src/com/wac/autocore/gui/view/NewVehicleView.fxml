<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.ComboBox?>
<VBox spacing="15" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <children>
        <Label text="New Vehicle" styleClass="heading-2" />

        <GridPane hgap="10" vgap="10">
            <Label text="Registration Number:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="registrationNumberField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Brand:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="brandField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Model:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="modelField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Year:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="yearField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label text="Customer:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <ComboBox fx:id="customerComboBox" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        </GridPane>

        <HBox styleClass="button-spacing">
            <Button text="Save Vehicle" onAction="#handleSaveVehicle" />
            <Button text="Cancel" onAction="#handleCancel" />
        </HBox>
    </children>
</VBox>