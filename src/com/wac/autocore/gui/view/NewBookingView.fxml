<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="container-padding,container-spacing"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.wac.autocore.gui.controller.BookingController">

    <children>

        <!-- Titel -->
        <Label text="New Booking" styleClass="heading-2" />

        <!-- GridPane för alla fält -->
        <GridPane styleClass="form-grid">

            <!-- Vehicle -->
            <Label text="Vehicle:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="vehicleIdField"
                      promptText="Select vehicle"
                      GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <!-- Date -->
            <Label text="Date:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <DatePicker fx:id="datePicker"
                        promptText="YYYY-MM-DD"
                        GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <!-- Description -->
            <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextArea fx:id="descriptionField"
                      promptText="Enter description"
                      prefRowCount="3"
                      wrapText="true"
                      GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        </GridPane>

        <!-- Buttons -->
        <HBox styleClass="button-row">
            <Button text="Save Booking" onAction="#handleSaveBooking"/>
            <Button text="Cancel" onAction="#handleCancel"/>
        </HBox>

    </children>
</VBox>



