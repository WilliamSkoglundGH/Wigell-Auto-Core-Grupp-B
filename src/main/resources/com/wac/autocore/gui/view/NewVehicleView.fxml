<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.ComboBox?>
<VBox spacing="15" xmlns="http://javafx.com/javafx"
      styleClass="form-padding"
      xmlns:fx="http://javafx.com/fxml">


    <children>
        <Label text="%vehicle.newHeading" styleClass="heading-2" />

        <GridPane hgap="10" vgap="10">
            <Label text="%vehicle.registrationNumberLabel" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="registrationNumberField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="%vehicle.brandLabel" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="brandField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="%vehicle.modelLabel" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="modelField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="%vehicle.yearLabel" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="yearField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label text="%vehicle.customerLabel" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <ComboBox fx:id="customerComboBox" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        </GridPane>

        <HBox styleClass="button-spacing">
            <Button text="%btn.save" onAction="#handleSaveVehicle" />
            <Button text="%btn.cancel" onAction="#handleCancel" />
        </HBox>
    </children>
</VBox>