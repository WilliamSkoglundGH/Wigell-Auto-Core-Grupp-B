<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.wac.autocore.gui.controller.WorkOrderController"
            prefHeight="400.0" prefWidth="600.0">

        <children>
            <Label text="%workorder.claims.heading" styleClass="heading-2" />
            <!-- Description -->
            <Label text="%workorder.claim.descriptionLabel" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
           <VBox styleClass="container-padding">
            <TextArea fx:id="descriptionFieldClaim"
                      promptText="%booking.prompt-desc"
                      prefRowCount="3"
                      wrapText="true"
                      prefWidth="250"
                      GridPane.columnIndex="1" GridPane.rowIndex="4"/>
           </VBox>

            <Button text="%btn.save"/>
            <Button text="%btn.cancel" onAction="#handleCancel" />
        </children>
    </VBox>

