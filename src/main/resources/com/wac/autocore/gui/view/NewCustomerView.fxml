<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" xmlns="http://javafx.com/javafx"
      styleClass="form-padding"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.wac.autocore.gui.controller.CustomerController">

    <children>
        <Label text="%customer.newHeading" styleClass="heading-2" />

        <GridPane hgap="10" vgap="10">
            <Label text="%customer.nameLabel" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="%customer.phoneLabel" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="phoneField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="%customer.emailLabel" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="%customer.vipLabel" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <CheckBox fx:id="vipCheckBox" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        </GridPane>

        <HBox styleClass="button-spacing">
            <Button text="%btn.save" onAction="#handleSaveCustomer" />
            <Button text="%btn.cancel" onAction="#handleCancel" />
        </HBox>
    </children>
</VBox>