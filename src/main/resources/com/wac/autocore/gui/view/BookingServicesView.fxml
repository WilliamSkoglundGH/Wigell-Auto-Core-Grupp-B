<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Separator?>
<VBox styleClass="container-padding,container-spacing"
      fx:controller="com.wac.autocore.gui.controller.BookingController"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml">

    <GridPane hgap="12" vgap="8">
        <columnConstraints>
            <ColumnConstraints minWidth="120" />
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="%booking.mechanicLabel"  GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="mechanicLabel"        GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="%booking.service.id"   GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="bookingIdLabel"      GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="%mechanic.bookings.customerColumn"    GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="customerLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="%booking.vehicleLabel"   GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="vehicleLabel"      GridPane.rowIndex="3" GridPane.columnIndex="1"/>

    </GridPane>

    <Separator/>
    <children>

        <Label text="%booking.services.heading"
               styleClass="heading-2"/>

        <TableView fx:id="bookingServicesTable" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="%booking.services.empty"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="serviceNameColumn"
                             text="%table.name"
                             prefWidth="260"/>
                <TableColumn fx:id="servicePriceColumn"
                             text="%serviceItem.priceColumn"
                             prefWidth="140"/>
                <TableColumn fx:id="serviceDurationColumn"
                             text="%serviceItem.estimatedMinutesColumn"
                             prefWidth="140"/>
            </columns>
        </TableView>

        <HBox styleClass="button-spacing">
            <Button fx:id="removeServiceButton"
                    text="%booking.services.remove"
                    onAction="#handleRemoveBookingService"/>

            <Button fx:id="addServiceButton"
                    text="%booking.services.add"
                    onAction="#handleAddBookingService"/>

            <Button text="%btn.back"
                    onAction="#handleBackToBookings"/>
        </HBox>

            <Label fx:id="servicesLockedLabel"
               styleClass="booking-services-info"
               wrapText="true"
               managed="false"
               visible="false"/>

    </children>
</VBox>
