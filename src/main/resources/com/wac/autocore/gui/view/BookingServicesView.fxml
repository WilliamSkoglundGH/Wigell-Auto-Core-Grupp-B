<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.Region?>
<VBox styleClass="container-padding,container-spacing"
      fx:controller="com.wac.autocore.gui.controller.BookingController"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml">

    <children>

        <Label text="%booking.services.heading"
               styleClass="heading-2"/>

        <TableView fx:id="bookingServicesTable" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="%booking.services.empty"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="serviceNameColumn"
                             text="%table.name"
                             prefWidth="260"/>
                <TableColumn fx:id="servicePriceColumn"
                             text="%serviceItem.priceColumn"
                             prefWidth="140"/>
                <TableColumn fx:id="serviceDurationColumn"
                             text="%serviceItem.estimatedMinutesColumn"
                             prefWidth="140"/>
            </columns>
        </TableView>

        <HBox styleClass="button-spacing" alignment="CENTER_LEFT">
            <Button fx:id="removeServiceButton"
                    text="%booking.services.remove"
                    onAction="#handleRemoveBookingService"/>

            <Button fx:id="addServiceButton"
                    text="%booking.services.add"
                    onAction="#handleAddBookingService"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="%booking.services.back"
                    onAction="#handleBackToBookings"/>
        </HBox>

            <Label fx:id="servicesLockedLabel"
               styleClass="booking-services-info"
               wrapText="true"
               managed="false"
               visible="false"/>

    </children>
</VBox>
