<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="container-padding,container-spacing"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.wac.autocore.gui.controller.CustomerController">

    <children>
        <Label text="%customer.heading" styleClass="heading-2" />

        <TableView fx:id="customerTable">
            <columns>
                <TableColumn fx:id="idColumn" text="%table.id" />
                <TableColumn fx:id="nameColumn" text="%table.name" />
                <TableColumn fx:id="emailColumn" text="%customer.emailColumn" />
                <TableColumn fx:id="phoneColumn" text="%customer.phoneColumn" />
                <TableColumn fx:id="vipColumn" text="%customer.vipColumn" />
            </columns>
        </TableView>

        <Button text="%btn.new" onAction="#handleNewCustomer" />
    </children>
</VBox>