<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" xmlns="http://javafx.com/javafx"
      styleClass="form-padding"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.wac.autocore.gui.controller.PaymentController">

    <children>
        <Label text="%payment.newHeading" styleClass="heading-2" />

        <GridPane hgap="10" vgap="10">
            <Label text="%payment.invoiceLabel" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="invoiceComboBox" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="%payment.paymentTypeLabel" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="paymentTypeComboBox" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        </GridPane>

        <HBox spacing="10">
            <Button text="%payment.payInFullButton" onAction="#handleSavePayment" />
            <Button text="%btn.cancel" onAction="#handleCancel" />
        </HBox>
    </children>
</VBox>