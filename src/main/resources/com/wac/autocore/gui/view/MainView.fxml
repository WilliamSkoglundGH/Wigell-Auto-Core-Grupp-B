<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainRoot" prefHeight="800.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wac.autocore.gui.controller.MainController">

    <!-- HEADER HÖGST UPP -->
    <top>
        <VBox spacing="10" styleClass="header-box">

         <ImageView   fitHeight="175" preserveRatio="true">
            <image>
                <!--    <Image url="@../img/lettercombo-logo/lettercombo-light-trp.png" />-->
               <Image url="@../img/wac-wac-logo/wac-wac-yellow-trp.png" />
            </image>

         </ImageView>

            <Separator prefWidth="Infinity" />
        </VBox>

    </top>

    <!-- MENY TILL VÄNSTER -->
    <left>
        <VBox spacing="20" styleClass="nav-padding">

            <VBox spacing="10" styleClass="button-spacing,text-center">
                <Button fx:id="customerButton" onAction="#showCustomerView" prefWidth="130" text="%nav.customers" />
                <Button fx:id="vehicleButton" onAction="#showVehicleView" prefWidth="130" text="%nav.vehicles" />
                <Button fx:id="bookingButton" onAction="#showBookingView" prefWidth="130" text="%nav.bookings" />
                <Button fx:id="workOrderButton" onAction="#showWorkOrderView" prefWidth="130" text="%nav.workorders" />
                <Button fx:id="invoiceButton" onAction="#showInvoiceView" prefWidth="130" text="%nav.invoices" />
                <Button fx:id="paymentButton" onAction="#showPaymentView" prefWidth="130" text="%nav.payments" />
                <Button fx:id="serviceItemButton" onAction="#showServiceItemView" prefWidth="130" text="%nav.serviceitems" />
                <Button fx:id="mechanicButton" onAction="#showMechanicView" prefWidth="130" text="%nav.mechanics" />
                </VBox>
        </VBox>
    </left>

    <!-- MEDDELANDEN TILL ANVÄNDAREN -->
    <bottom>
        <HBox alignment="BOTTOM_CENTER" spacing="10" styleClass="container-padding-small,msg-area">
             <Label fx:id="messageLabel" alignment="CENTER" maxWidth="Infinity" prefHeight="90" styleClass="msg-area" wrapText="true" HBox.hgrow="ALWAYS" />
            <VBox styleClass="button-spacing,text-center,footer">
                <children>
                    <Button fx:id="languageButton" onAction="#handleToggleLanguage" prefWidth="130" text="%nav.language">
                        <tooltip>
                            <Tooltip text="%tooltip.language-btn" />
                        </tooltip>
                    </Button>
                    <Button fx:id="exitButton" onAction="#handleExit" prefWidth="130" text="%nav.exit" />
                </children>
            </VBox>
        </HBox>
    </bottom>

    </BorderPane>
