<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="container-padding,container-spacing" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.wac.autocore.gui.controller.VehicleController">

    <children>
        <Label text="%vehicle.heading" styleClass="heading-2" />

        <TableView fx:id="vehicleTable">
            <columns>
                <TableColumn fx:id="idColumn" text="%table.id" />
                <TableColumn fx:id="registrationNumberColumn" text="%vehicle.registrationNumberColumn" />
                <TableColumn fx:id="brandColumn" text="%vehicle.brandColumn" />
                <TableColumn fx:id="modelColumn" text="%vehicle.modelColumn" />
                <TableColumn fx:id="yearColumn" text="%vehicle.yearColumn" />
                <TableColumn fx:id="customerIdColumn" text="%vehicle.customerIdColumn" />
            </columns>
        </TableView>

        <Button text="%btn.new" onAction="#handleNewVehicle" />
    </children>
</VBox>