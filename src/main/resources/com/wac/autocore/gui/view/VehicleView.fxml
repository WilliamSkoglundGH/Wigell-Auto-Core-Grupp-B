<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="container-padding,container-spacing" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.wac.autocore.gui.controller.VehicleController">

    <children>
        <Label text="Vehicle Management" styleClass="heading-2" />

        <TableView fx:id="vehicleTable">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" />
                <TableColumn fx:id="registrationNumberColumn" text="Registration Number" />
                <TableColumn fx:id="brandColumn" text="Brand" />
                <TableColumn fx:id="modelColumn" text="Model" />
                <TableColumn fx:id="yearColumn" text="Year" />
                <TableColumn fx:id="customerColumn" text="Customer" />
            </columns>
        </TableView>

        <Button text="New" onAction="#handleNewVehicle" />
    </children>
</VBox>