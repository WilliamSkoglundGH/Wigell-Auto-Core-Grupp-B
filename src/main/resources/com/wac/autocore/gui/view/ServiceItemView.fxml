<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<VBox styleClass="container-padding,container-spacing"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.wac.autocore.gui.controller.ServiceItemController">

    <children>
        <Label text="%serviceItem.heading" styleClass="heading-2" />

        <TableView fx:id="serviceItemTable" editable="true">
            <columns>
                <TableColumn fx:id="idColumn" text="%table.id" />
                <TableColumn fx:id="nameColumn" text="%table.name" />
                <TableColumn fx:id="descriptionColumn" text="%table.description" />
                <TableColumn fx:id="priceColumn"
                             text="%serviceItem.priceColumn"
                             editable="true"
                             styleClass="editable-column"/>

                <TableColumn fx:id="estimatedMinutesColumn" text="%serviceItem.estimatedMinutesColumn" />
            </columns>
        </TableView>
        <HBox styleClass="button-spacing">
            <Button text="%btn.new" onAction="#handleNewServiceItemOrder" />
            <Button fx:id="showPackageButton" text="%serviceItem.show_packages" onAction="#handleShowPackages"/>
            <Button fx:id="newPackageButton" text="%serviceItem.new_package" onAction="#handleNewPackage"/>
        </HBox>
    </children>
</VBox>